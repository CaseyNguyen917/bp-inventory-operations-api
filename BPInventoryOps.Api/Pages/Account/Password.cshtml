@page
@model BPInventoryOps.Api.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="page-heading"><div><p class="eyebrow">YOUR ACCOUNT</p><h1>Change password</h1><p>Use at least 10 characters, including uppercase, lowercase, a number and a symbol.</p></div></div>
<form method="post" class="panel form-panel">
<div asp-validation-summary="All" role="alert"></div>
<label asp-for="Input.CurrentPassword">Current password</label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required />
<label asp-for="Input.NewPassword">New password</label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password" minlength="10" required />
<div class="form-actions"><button class="button">Update password</button><a asp-page="/Index">Cancel</a></div>
</form>
