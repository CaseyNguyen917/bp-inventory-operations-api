@page "{id:int?}"
@model BPInventoryOps.Api.Pages.Categories.EditModel
@{ ViewData["Title"] = Model.Existing is null ? "Add category" : "Edit category"; }
<div class="page-heading"><div><p class="eyebrow">Catalog management</p><h1>@ViewData["Title"]</h1><p>Changes are recorded in the audit history.</p></div></div>
<div class="panel form-panel"><form method="post" class="panel-body">
<div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="form-grid"><div class="field"><label asp-for="Input.Name">Name</label><input asp-for="Input.Name"  required /></div></div>
<div class="form-actions"><button class="button" type="submit">Save category</button><a class="button secondary" asp-page="/Categories/Index">Cancel</a></div>
</form></div>
@if (Model.Existing is { } existing)
{
    <section class="panel status-panel"><div><h2>@(existing.IsActive ? "Deactivate category" : "Reactivate category")</h2><p>Deactivation is blocked while active products reference this record. History is preserved.</p></div>
    <form method="post" asp-page-handler="@(existing.IsActive ? "Deactivate" : "Reactivate")" asp-route-id="@existing.Id" data-confirm="Change this category's active status?"><button class="button @(existing.IsActive ? "danger" : "secondary")" type="submit">@(existing.IsActive ? "Deactivate" : "Reactivate")</button></form></section>
}

