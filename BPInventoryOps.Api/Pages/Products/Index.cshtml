@page
@model BPInventoryOps.Api.Pages.Products.IndexModel
@{ ViewData["Title"] = "Products"; bool manager = User.IsInRole(ApplicationRoles.Manager) || User.IsInRole(ApplicationRoles.Admin); }
<div class="page-heading"><div><p class="eyebrow">MERCHANDISE CATALOG</p><h1>Products</h1><p>Find stock, check prices, and keep your catalog up to date.</p></div>
@if (manager) { <a class="button" asp-page="Edit">+ Add product</a> }</div>
<form method="get" class="filters">
<div class="field wide"><label asp-for="Query.Search">Search name or SKU</label><input asp-for="Query.Search" placeholder="Find a product…" /></div>
<div class="field"><label asp-for="Query.CategoryId">Category</label><select asp-for="Query.CategoryId" asp-items="Model.Categories"><option value="">All categories</option></select></div>
<div class="field"><label asp-for="Query.VendorId">Vendor</label><select asp-for="Query.VendorId" asp-items="Model.Vendors"><option value="">All vendors</option></select></div>
<div class="field"><label asp-for="Query.SortBy">Sort by</label><select asp-for="Query.SortBy"><option value="name">Name</option><option value="sku">SKU</option><option value="quantityOnHand">On hand</option><option value="retailPrice">Price</option></select></div>
<div class="field"><label asp-for="Query.SortDirection">Order</label><select asp-for="Query.SortDirection"><option value="asc">Ascending</option><option value="desc">Descending</option></select></div>
<label class="checkbox"><input asp-for="Query.IncludeInactive" /> Include inactive</label><button class="button">Apply</button><a asp-page="Index">Reset</a>
</form>
<div class="panel">
@if (Model.Data.Items.Count == 0) { <div class="empty-state"><h2>No products found</h2><p>Try another search or clear your filters.</p></div> }
else { <div class="table-wrap"><table><thead><tr><th>Product</th><th>Category / Vendor</th><th class="number">On hand</th><th class="number">Threshold</th><th class="number">Retail price</th><th>Status</th></tr></thead><tbody>
@foreach (var p in Model.Data.Items) { <tr><td><a asp-page="Details" asp-route-id="@p.Id">@p.Name</a><small>@p.Sku</small></td><td>@p.Category.Name<small>@p.PrimaryVendor.Name</small></td><td class="number">@p.QuantityOnHand</td><td class="number">@p.ReorderThreshold</td><td class="number">$@p.RetailPrice.ToString("N2")</td><td><span class="badge @(!p.IsActive ? "inactive" : p.IsLowStock ? "low" : "")">@(!p.IsActive ? "Inactive" : p.IsLowStock ? "Low stock" : "In stock")</span></td></tr> }
</tbody></table></div> }
<partial name="_Pagination" model="new Pagination(Model.Data.Page, Model.Data.TotalPages, Model.Data.TotalCount)" />
</div>
